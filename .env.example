# Example environment variables for local development and Netlify (DO NOT commit real secrets)
# Choose SEARCH_PROVIDER: "serper" (default) or "google-cse"
SEARCH_PROVIDER=serper
# Serper API key (https://serper.dev)
SERPER_API_KEY=
# Google Custom Search Engine keys (only if using google-cse)
GOOGLE_API_KEY=
GOOGLE_CX=
# Owner dashboard token (generate a long random string, 24+ chars)
DASHBOARD_TOKEN=
# Optional alerting
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
# Optional dashboard URL override
DASHBOARD_URL=
